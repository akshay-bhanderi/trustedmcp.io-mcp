{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.trustedmcp/trustedmcp",
  "title": "TrustedMCP",
  "description": "A-D grades for MCP servers: look one up, check your MCP config, find graded alternatives.",
  "repository": {
    "url": "https://github.com/akshay-bhanderi/trustedmcp.io-mcp",
    "source": "github"
  },
  "websiteUrl": "https://trustedmcp.io/developers",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "trustedmcp",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TRUSTEDMCP_API_KEY",
          "description": "Free key from trustedmcp.io/developers (scopes: servers:read, config:check, registry:read)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://trustedmcp.io/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <free key from trustedmcp.io/developers>",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
